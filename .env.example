# Resend API key (https://resend.com/api-keys) - recommended free email service
RESEND_API_KEY=

# Where contact form enquiries are sent (default: hello@inwaits.com)
CONTACT_TO_EMAIL=hello@inwaits.com

# Sender address (e.g., once domain inwaits.com is verified in Resend)
# CONTACT_FROM_EMAIL="Inwaits Website <notifications@inwaits.com>"

# Alternative: Direct SMTP settings (if using your hello@inwaits.com webmail / cPanel / Zoho SMTP)
# SMTP_HOST=mail.inwaits.com
# SMTP_PORT=465
# SMTP_USER=hello@inwaits.com
# SMTP_PASS=your_email_password
# SMTP_SECURE=true

# Public site URL
NEXT_PUBLIC_SITE_URL=https://inwaits.com
