# Copy this file to .env.local and fill in the values.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Where contact form enquiries are sent
CONTACT_TO_EMAIL=hello@inwaits.com

# Sender address. Must use a domain verified in Resend, for example:
#   CONTACT_FROM_EMAIL="Inwaits Website <website@inwaits.com>"
# Leave empty to use Resend's test sender (onboarding@resend.dev), which can
# only send to the email address of your own Resend account.
CONTACT_FROM_EMAIL=

# Public site URL (used for SEO metadata)
NEXT_PUBLIC_SITE_URL=https://inwaits.com
